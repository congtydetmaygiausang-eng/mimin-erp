{
  "version": "2.0.0",
  "name": "MIMIN ERP Orchestrator (9 Agent Tổng hợp)",
  "description": "Router thông minh cho 9 chuyên gia AI của MIMIN ERP. Phân tích yêu cầu của sếp Sang → route tới agent phù hợp.",
  "model_primary": "claude-opus-4-20250514",
  "model_fallback": "deepseek-r1",
  "agents": [
    "agent-san-xuat",
    "agent-kho",
    "agent-ke-toan",
    "agent-nhan-su",
    "agent-deepseek",
    "agent-ban-hang",
    "agent-tai-chinh",
    "agent-theo-doi-cd",
    "agent-ky-thuat-may"
  ],
  "agent_metadata": {
    "agent-san-xuat": {
      "name": "Anh Hùng - GĐ Sản xuất",
      "module": "san-xuat",
      "scope": "Quản lý 7 công đoạn SX: cắt, INTD, may, khuy nút, ủi, đóng gói, nhập kho. Tối ưu OEE, lead time, tỷ lệ hoàn thành đúng hạn.",
      "tables": ["lenh_sx_tong", "phieu_workflow", "lsx_tong", "tasks"]
    },
    "agent-kho": {
      "name": "Anh Khoa - GĐ Kho",
      "module": "kho",
      "scope": "Quản lý 4 kho: Vải, Sợi, Phụ liệu, Thành phẩm. FIFO, tồn kho, dead stock, kiểm kê.",
      "tables": ["kho_vai_v2", "kho_soi_v2", "kho_phu_lieu_v2", "kho_thanh_pham_v2"]
    },
    "agent-ke-toan": {
      "name": "Anh Sơn - Kế toán trưởng",
      "module": "ke-toan",
      "scope": "Công nợ, sổ sách, AR/AP, phiếu thu chi, hóa đơn đầu vào/ra.",
      "tables": ["phieu_thu_chi", "cong_no_phai_thu", "cong_no_phai_tra", "ncc_v2"]
    },
    "agent-nhan-su": {
      "name": "Chị Mai - Trưởng phòng NS",
      "module": "nhan-su",
      "scope": "Hồ sơ NV, lương, BHXH, chấm công, tuyển dụng, đánh giá.",
      "tables": ["users", "cham_cong", "bang_luong", "hop_dong"]
    },
    "agent-deepseek": {
      "name": "Anh Sâu - AI Toàn năng",
      "module": "deepseek",
      "scope": "Tổng hợp, phân tích chiến lược, giải quyết vấn đề phức tạp, dịch thuật, lập trình.",
      "tables": []
    },
    "agent-ban-hang": {
      "name": "Chị Hoa - Trưởng phòng Bán hàng",
      "module": "ban-hang",
      "scope": "KH, đơn hàng, doanh thu, chiết khấu, CRM.",
      "tables": ["khach_hang", "don_hang", "bao_gia"]
    },
    "agent-tai-chinh": {
      "name": "Anh Quốc - CFO",
      "module": "tai-chinh",
      "scope": "Thuế (GTGT/TNCN/TNDN), BHXH, hóa đơn điện tử, báo cáo TC, ngân sách, dòng tiền.",
      "tables": ["thue_v2", "hoa_don_dien_tu", "bao_cao_tai_chinh"]
    },
    "agent-theo-doi-cd": {
      "name": "Chị Hạnh - Theo dõi SX",
      "module": "theo-doi-cd",
      "scope": "7 công đoạn + QC + hàng sửa + nhắc NV sửa + đóng gói + nhập kho.",
      "tables": ["phieu_workflow", "qc_ket_qua", "hang_sua", "tasks"]
    },
    "agent-ky-thuat-may": {
      "name": "Anh Tuấn KT - Kỹ thuật may",
      "module": "ky-thuat-may",
      "scope": "Xử lý lỗi SX: đường chỉ, mũi chỉ, độ căng, pattern, máy may hỏng, cải tiến quy trình.",
      "tables": ["loi_sx", "xu_ly_loi", "may_moc", "bang_keo"]
    }
  },
  "routing_rules": [
    {
      "keywords": ["sản xuất", "lệnh sx", "lsx", "công đoạn", "lead time", "oee", "tăng ca", "tổ sx", "phân công"],
      "agent": "agent-san-xuat",
      "priority": 1
    },
    {
      "keywords": ["kho", "nhập kho", "xuất kho", "tồn kho", "kiểm kê", "fifo", "dead stock", "4 kho"],
      "agent": "agent-kho",
      "priority": 1
    },
    {
      "keywords": ["công nợ", "phải thu", "phải trả", "phiếu thu", "phiếu chi", "ar", "ap", "ncc", "sổ sách", "quyết toán"],
      "agent": "agent-ke-toan",
      "priority": 1
    },
    {
      "keywords": ["nhân viên", "nhân sự", "lương", "bhxh", "chấm công", "tuyển dụng", "hợp đồng lao động", "đánh giá nv", "ns nội bộ"],
      "agent": "agent-nhan-su",
      "priority": 1
    },
    {
      "keywords": ["bán hàng", "khách hàng", "đơn hàng", "doanh thu", "sales", "crm", "chốt deal", "kh mới", "đơn sỉ"],
      "agent": "agent-ban-hang",
      "priority": 1
    },
    {
      "keywords": ["thuế", "hóa đơn", "gtgt", "tncn", "tndn", "báo cáo tài chính", "cash flow", "ebitda", "cfo", "ngân sách", "bảo hiểm xã hội"],
      "agent": "agent-tai-chinh",
      "priority": 1
    },
    {
      "keywords": ["theo dõi", "công đoạn", "gia công", "qc", "khuy nút", "ủi", "đóng gói", "nhập kho tp", "hàng sửa", "rework", "nhắc sửa"],
      "agent": "agent-theo-doi-cd",
      "priority": 1
    },
    {
      "keywords": ["lỗi sx", "lỗi may", "lỗi đường chỉ", "mũi chỉ", "độ căng", "pattern", "máy may hỏng", "kỹ thuật may", "xử lý lỗi", "cải tiến"],
      "agent": "agent-ky-thuat-may",
      "priority": 1
    },
    {
      "keywords": ["sợi dệt nhuộm", "sợi→dệt→nhuộm", "quy trình vải", "tính sợi", "hao hụt dệt", "bottleneck dệt", "dệt nhuộm", "vải thành phẩm"],
      "agent": "agent-ky-thuat-may",
      "priority": 2
    },
    {
      "keywords": ["phân tích tổng hợp", "chiến lược", "tư vấn", "lập trình", "dịch", "viết code", "toàn năng", "sâu", "deepseek"],
      "agent": "agent-deepseek",
      "priority": 2
    }
  ],
  "default_agent": "agent-san-xuat",
  "multi_agent_chains": {
    "lenh_sx_moi": ["agent-ban-hang", "agent-san-xuat", "agent-kho"],
    "hoa_don_thue": ["agent-ban-hang", "agent-tai-chinh"],
    "thu_hoi_cong_no": ["agent-ke-toan", "agent-ban-hang"],
    "nhap_hang_ncc": ["agent-kho", "agent-ke-toan"],
    "xuat_kho_giao_kh": ["agent-kho", "agent-ban-hang", "agent-theo-doi-cd"],
    "tuyen_nv_moi": ["agent-nhan-su", "agent-san-xuat"],
    "sua_hang_loi": ["agent-theo-doi-cd", "agent-ky-thuat-may"],
    "tinh_gia_thanh_vai": ["agent-ky-thuat-may", "agent-tai-chinh"]
  }
}
