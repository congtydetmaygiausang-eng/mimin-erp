# JT9 is a dark-launch service. Keep it disabled until an internal server caller exists.
COMPANY_READER_ENABLED=false

# Generate at least 32 random characters. Never expose this value to NEXT_PUBLIC_*.
COMPANY_READER_SERVICE_TOKEN=replace-with-a-random-internal-service-token

# Only acknowledge this for a single-instance dark launch. Production must inject Redis adapters.
COMPANY_READER_ALLOW_MEMORY_GUARDRAILS=false

# Optional, server-only fallback credential.
JINA_API_KEY=
