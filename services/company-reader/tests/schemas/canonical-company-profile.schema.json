{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mimin.vn/schemas/canonical-company-profile.schema.json",
  "title": "JT7 Canonical Company Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["group_id", "status", "fields", "source_count", "strong_keys", "warnings"],
  "properties": {
    "group_id": {"type": "string"},
    "status": {"enum": ["READY_FOR_REVIEW", "NEEDS_REVIEW", "BLOCKED"]},
    "fields": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "status", "selected_value", "normalized_value", "confidence", "independent_source_count", "evidence", "alternatives", "reasons"],
        "properties": {
          "field": {"enum": ["LEGAL_NAME", "TAX_CODE", "ADDRESS", "PHONE", "EMAIL", "WEBSITE", "INTRODUCTION"]},
          "status": {"enum": ["CONSENSUS", "SINGLE_SOURCE", "REVIEW_REQUIRED", "CONFLICT", "MISSING"]},
          "selected_value": {"type": ["string", "null"]},
          "normalized_value": {"type": ["string", "null"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "independent_source_count": {"type": "integer", "minimum": 0},
          "evidence": {"type": "array", "items": {"type": "object"}},
          "alternatives": {"type": "array", "items": {"type": "string"}},
          "reasons": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "source_count": {"type": "integer", "minimum": 0},
    "strong_keys": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
