{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mimin.vn/schemas/company-reader/company-candidate-bundle.schema.json",
  "title": "JT3 CompanyCandidateBundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_url", "text_sha256", "status", "candidates", "distinct_legal_names", "distinct_tax_codes", "multi_entity", "warnings"],
  "properties": {
    "source_url": {"type": ["string", "null"], "maxLength": 2048},
    "text_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["OK", "MULTI_ENTITY_REVIEW", "NO_IDENTITY", "SKIPPED_EXTRACTION_ERROR"]},
    "candidates": {
      "type": "array",
      "maxItems": 70,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "value", "normalized_value", "confidence", "origin", "source_url", "text_sha256", "excerpt", "start", "end", "labels", "warnings"],
        "properties": {
          "field": {"enum": ["LEGAL_NAME", "TAX_CODE", "ADDRESS", "PHONE", "EMAIL", "WEBSITE", "INTRODUCTION"]},
          "value": {"type": "string", "minLength": 1, "maxLength": 1200},
          "normalized_value": {"type": "string", "minLength": 1, "maxLength": 1200},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "origin": {"enum": ["MAIN_TEXT", "METADATA_TITLE", "METADATA_DESCRIPTION"]},
          "source_url": {"type": ["string", "null"], "maxLength": 2048},
          "text_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "excerpt": {"type": "string", "minLength": 1, "maxLength": 500},
          "start": {"type": ["integer", "null"], "minimum": 0},
          "end": {"type": ["integer", "null"], "minimum": 0},
          "labels": {"type": "array", "items": {"type": "string", "maxLength": 80}},
          "warnings": {"type": "array", "items": {"type": "string", "maxLength": 80}}
        }
      }
    },
    "distinct_legal_names": {"type": "integer", "minimum": 0},
    "distinct_tax_codes": {"type": "integer", "minimum": 0},
    "multi_entity": {"type": "boolean"},
    "warnings": {"type": "array", "items": {"type": "string", "maxLength": 80}}
  }
}

