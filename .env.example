# ============================================
# MIMIN ERP - Environment Variables Example
# Copy file này thành .env.local rồi điền giá trị thật
# File .env.local KHÔNG được commit lên git
# ============================================

# ============================================
# 1. SUPABASE (BẮT BUỘC - Backend chính)
# ============================================
# URL của project Supabase
NEXT_PUBLIC_SUPABASE_URL=https://nftlwdcsmlpeiazhuoho.supabase.co

# Anon key (PUBLIC - an toàn để lộ ra client)
# Lấy từ: Dashboard > Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# Service role key (BÍ MẬT - chỉ server-side, có full quyền)
# Lấy từ: Dashboard > Settings > API > Project API keys > service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# Secret key mới (Supabase 2024+) - thay thế service_role
SUPABASE_SECRET_KEY=sb_secret_xxxxx

# Publishable key (Supabase 2024+) - thay thế anon trong một số flow
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx

# Connection string (cho psql - optional)
# Lấy từ: Dashboard > Database > Connection string > URI
# DATABASE_URL=postgresql://postgres.nftlwdcsmlpeiazhuoho:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ============================================
# 2. AI SERVICES (Optional - dùng cho AI features)
# ============================================
# DeepSeek API
DEEPSEEK_API_KEY=sk-xxxxx

# MiniMax API
MINIMAX_API_KEY=eyJxxxxx

# Google Maps API (Dùng cho Sourcing Search)
GOOGLE_MAPS_API_KEY=AIzaSyXxxxxx

# ============================================
# 3. FIREBASE (Optional - dùng cho storage/analytics)
# ============================================
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mimin-erp.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=mimin-erp.appspot.com
# Thường có thêm:
# NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyXxxxxx
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=mimin-erp
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
# NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:xxxxx

# ============================================
# 4. LARK / FEISHU (Optional - sync Lark Base)
# ============================================
# LARK_APP_ID=cli_xxxxx
# LARK_APP_SECRET=xxxxx
# LARK_WORKSPACE=kjph64hnjkl5.jp.larksuite.com
# LARK_BASE_ID=NNKRbEQcYak0Ees0v61j2iXypEc

# ============================================
# 5. APP CONFIG
# ============================================
# NEXT_PUBLIC_APP_NAME=MIMIN ERP
# NEXT_PUBLIC_APP_VERSION=89.6.8
